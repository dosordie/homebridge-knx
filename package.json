{
    "name": "homebridge-knx",
    "version": "0.5.0-beta.13-dosordie.8",
    "description": "Homebridge KNX platform plugin fork with Homebridge 2.x support, custom configuration UI, YAML/JSON config editing, and knxjs fixes.",
    "main": "index.js",
    "scripts": {
        "check": "find . -path './node_modules' -prune -o -path './ui/public/vendor' -prune -o -name '*.js' -print | sort | xargs -r -n1 node --check",
        "test": "npm run check",
        "start": "echo \"Error: configure and run homebridge to start\" && exit 1"
    },
    "engines": {
        "node": ">14.0.0",
        "homebridge": ">=2.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/dosordie/homebridge-knx.git"
    },
    "keywords": [
        "homebridge-plugin",
        "homebridge",
        "KNX",
        "knx",
        "knxd",
        "eibd",
        "EIB",
        "Siri"
    ],
    "dependencies": {
        "@homebridge/plugin-ui-utils": "^2.2.4",
        "debug": "^4.3.4",
        "eibd": "^0.5.1",
        "js-yaml": "^4.1.0",
